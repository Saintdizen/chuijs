{
    "root": true,
    "env": {
        "commonjs": true,
        "es2021": true,
        "node": true,
        "browser": true
    },
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "extends": ["eslint:recommended"],
    "ignorePatterns": ["node_modules/", "package-lock.json"],
    "rules": {
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
        "no-constant-condition": ["error", { "checkLoops": false }]
    }
}
